# Git 仓库配置
GIT_REPO_URL=git@github.com:your-org/your-repo.git
PAY_GIT_REPO_URL=git@github.com:your-org/your-pay-repo.git
# SSH 私钥在宿主机上的绝对路径（容器启动时挂载用于 clone）
GIT_SSH_KEY_PATH=/home/user/.ssh/id_rsa

# 是否启动 mysql 容器（true / false），false 时需自行提供外部数据库
# 云服务器部署设为 false（使用外部数据库），本地开发可设为 true
ENABLE_MYSQL=false

# 是否执行数据库初始化脚本 init_db.sh（true / false）
# 使用 Flyway 管理数据库时设为 false，避免与 Flyway 冲突
ENABLE_INIT_DB=false

# 数据库配置（外部数据库，云服务器与数据库服务器需在同一网段）
DB_HOST=10.0.0.x
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=mydb

# oss服务器配置
OSS_ENDPOINT=your-endpoint
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=your-bucket-name

# Nginx 服务域名 / IP
SERVER_NAME=your-domain.com

# 支付模式：mock（模拟）/ real（真实微信支付）
PAY_MODE=mock

# Mock 查单返回状态（NOTPAY/SUCCESS/CLOSED/REVOKED）
MOCK_ORDER_STATE=NOTPAY

# 小程序配置
WX_APPID=123
WX_SECRET=123
# 小程序 JWT 签名密钥
M_JWT_SECRET=123

# 微信商户配置（PAY_MODE=real 时必填）
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_CERT_PATH=/app/certs
WECHAT_NOTIFY_URL=

# 定时查单兜底配置
ENABLE_ORDER_CHECK=true
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_CHECK_INTERVAL_SECONDS=300

# dashboard
BETTER_AUTH_SECRET=https://www.test.com
BETTER_AUTH_URL=https://www.test.com
TRUSTED_ORIGINS=https://www.test.com
PAYMENT_API_BASE_URL=https://www.test.com
OSS_API_BASE_URL=https://www.test.com
NEXT_PUBLIC_APP_URL=https://www.test.com