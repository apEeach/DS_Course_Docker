# Git 仓库配置
GIT_REPO_URL=git@github.com:your-org/your-repo.git
PAY_GIT_REPO_URL=git@github.com:your-org/your-pay-repo.git
# SSH 私钥在宿主机上的绝对路径（容器启动时挂载用于 clone）
GIT_SSH_KEY_PATH=/home/user/.ssh/id_rsa

# 是否启动 mysql 容器（true / false），false 时需自行提供外部数据库
# 云服务器部署设为 false（使用外部数据库），本地开发可设为 true
ENABLE_MYSQL=false

# 是否执行数据库初始化脚本 init_db.sh（true / false）
# 使用 Flyway 管理数据库时设为 false，避免与 Flyway 冲突
ENABLE_INIT_DB=false

# 数据库配置（外部数据库，云服务器与数据库服务器需在同一网段）
DB_HOST=10.0.0.x
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=mydb

# oss服务器配置
OSS_ENDPOINT=test
OSS_ACCESS_KEY_ID=test
OSS_ACCESS_KEY_SECRET=test
OSS_BUCKET_NAME=test

# Nginx 服务域名 / IP
SERVER_NAME=your-domain.com

# Go 支付服务镜像（CI/CD 构建时填入）
PAY_IMAGE=your-registry/sxd_server/test_pay:latest

# 支付模式：mock（模拟）/ real（真实微信支付）
PAY_MODE=mock

# Mock 查单返回状态（NOTPAY/SUCCESS/CLOSED/REVOKED）
MOCK_ORDER_STATE=NOTPAY

# 微信商户配置（PAY_MODE=real 时必填）
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_CERT_PATH=/app/certs
WECHAT_NOTIFY_URL=

# 定时查单兜底配置
ENABLE_ORDER_CHECK=true
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_CHECK_INTERVAL_SECONDS=300

# ==================== 多环境部署配置 ====================
# 部署目标：1（只部署第一套环境）、2（只部署第二套）、both（都部署）
# 每套环境需要独立的：ACR registry、SSH 主机、SSH 密钥
# 第二套环境变量留空则不登录、不推送、不部署
#
# 对应 GitHub Secrets：
#   第一套：ALIYUN_REGISTRY, ALIYUN_USERNAME, ALIYUN_PASSWORD, SSH_HOST, SSH_PRIVATE_KEY
#   第二套：ALIYUN_REGISTRY_2, ALIYUN_USERNAME_2, ALIYUN_PASSWORD_2, SSH_HOST_2, SSH_PRIVATE_KEY_2
#
# 示例：
#   DEPLOY_TARGET=1     # 只推第一套 registry，只部署到第一台服务器
#   DEPLOY_TARGET=2     # 两套 registry 都推（如果配了第二套），只部署到第二台服务器
#   DEPLOY_TARGET=both  # 两套 registry 都推，两台服务器都部署
DEPLOY_TARGET=1
