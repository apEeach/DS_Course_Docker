# Git 仓库配置
GIT_REPO_URL=git@github.com:apEeach/DS_Course.git
# SSH 私钥在宿主机上的绝对路径
GIT_SSH_KEY_PATH=/home/sxd/.ssh/id_rsa

# 是否启动 mysql 容器（true / false），false 时需自行提供外部数据库
# 云服务器部署设为 false（使用外部数据库），本地开发可设为 true
ENABLE_MYSQL=false

# 是否执行数据库初始化脚本 init_db.sh（true / false）
# 使用 Flyway 管理数据库时设为 false，避免与 Flyway 冲突
ENABLE_INIT_DB=false

# 数据库配置
DB_HOST=db
DB_USER=root
DB_PASS=root
DB_NAME=mydb

# Nginx 服务域名 / IP
SERVER_NAME=192.168.1.11
