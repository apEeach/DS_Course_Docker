# Git 仓库配置
GIT_REPO_URL=git@github.com:apEeach/DS_Course.git
PAY_GIT_REPO_URL=git@github.com:apEeach/DS_Course_Pay.git
# SSH 私钥在宿主机上的绝对路径
GIT_SSH_KEY_PATH=""

# 是否启动 mysql 容器（true / false），false 时需自行提供外部数据库
# 云服务器部署设为 false（使用外部数据库），本地开发可设为 true
ENABLE_MYSQL=false

# 支付模式：mock（模拟）/ real（真实微信支付）
PAY_MODE=real

# Mock 查单返回状态（NOTPAY/SUCCESS/CLOSED/REVOKED）
MOCK_ORDER_STATE=NOTPAY

# ===== 部门A 配置 =====
# Nginx 服务域名 / IP-部门A
SERVER_NAME=""

# 是否执行数据库初始化脚本 init_db.sh（true / false）-部门A
ENABLE_INIT_DB=true

# 数据库-部门A
DB_HOST=""
DB_USER=""
DB_PASS=""
DB_NAME=""
DATABASE_URL=""

# OSS-部门A
OSS_ENDPOINT=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET_NAME=""

# 小程序-部门A
WX_APPID=""
WX_SECRET=""
M_JWT_SECRET=""

# 微信商户（PAY_MODE=real 时必填）-部门A
WECHAT_APPID=""
WECHAT_MCH_ID=""
WECHAT_SERIAL_NO=""
WECHAT_API_V3_KEY=""
WECHAT_PUB_KEY_ID=""
WECHAT_CERT_PATH=/app/certs
WECHAT_NOTIFY_URL=""

# 定时查单兜底配置-部门A
ENABLE_ORDER_CHECK=true
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_CHECK_INTERVAL_SECONDS=300

# dashboard-部门A
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
TRUSTED_ORIGINS=""
PAYMENT_API_BASE_URL=""
OSS_API_BASE_URL=""
NEXT_PUBLIC_APP_URL=""

# ===== 部门B (D2) 配置 =====
# 支付模式：mock（模拟）/ real（真实微信支付）-部门B
PAY_MODE_D2=real

# Nginx 服务域名 / IP-部门B
SERVER_NAME_D2=""

# 是否执行数据库初始化脚本 init_db.sh（true / false）-部门B
ENABLE_INIT_DB_D2=true

# 数据库-部门B
DB_HOST_D2=""
DB_USER_D2=""
DB_PASS_D2=""
DB_NAME_D2=""
DATABASE_URL_D2=""

# OSS-部门B
OSS_ENDPOINT_D2=""
OSS_ACCESS_KEY_ID_D2=""
OSS_ACCESS_KEY_SECRET_D2=""
OSS_BUCKET_NAME_D2=""

# 小程序-部门B
WX_APPID_D2=""
WX_SECRET_D2=""
M_JWT_SECRET_D2=""

# 微信商户（PAY_MODE=real 时必填）-部门B
WECHAT_APPID_D2=""
WECHAT_MCH_ID_D2=""
WECHAT_SERIAL_NO_D2=""
WECHAT_API_V3_KEY_D2=""
WECHAT_PUB_KEY_ID_D2=""
WECHAT_CERT_PATH_D2=/app/certs
WECHAT_NOTIFY_URL_D2=""

# 定时查单兜底配置-部门B
ENABLE_ORDER_CHECK_D2=true
ORDER_PAYMENT_TIMEOUT_MINUTES_D2=30
ORDER_CHECK_INTERVAL_SECONDS_D2=300

# dashboard-部门B
BETTER_AUTH_SECRET_D2=""
BETTER_AUTH_URL_D2=""
TRUSTED_ORIGINS_D2=""
PAYMENT_API_BASE_URL_D2=""
OSS_API_BASE_URL_D2=""
NEXT_PUBLIC_APP_URL_D2=""
