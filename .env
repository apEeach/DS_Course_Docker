# Git 仓库配置
GIT_REPO_URL=git@github.com:apEeach/DS_Course.git
PAY_GIT_REPO_URL=git@github.com:apEeach/DS_Course_Pay.git
# SSH 私钥在宿主机上的绝对路径
GIT_SSH_KEY_PATH=/home/sxd/.ssh/id_rsa

# 是否启动 mysql 容器（true / false），false 时需自行提供外部数据库
# 云服务器部署设为 false（使用外部数据库），本地开发可设为 true
ENABLE_MYSQL=false

# 是否执行数据库初始化脚本 init_db.sh（true / false）
# 使用 Flyway 管理数据库时设为 false，避免与 Flyway 冲突
ENABLE_INIT_DB=false

# 数据库配置
DB_HOST=db
DB_USER=root
DB_PASS=root
DB_NAME=mydb

# oss服务器配置
OSS_ENDPOINT=test
OSS_ACCESS_KEY_ID=test
OSS_ACCESS_KEY_SECRET=test
OSS_BUCKET_NAME=test

# Nginx 服务域名 / IP
SERVER_NAME=192.168.1.11

# 支付模式：mock（模拟）/ real（真实微信支付）
PAY_MODE=mock

# Mock 查单返回状态（NOTPAY/SUCCESS/CLOSED/REVOKED）
MOCK_ORDER_STATE=NOTPAY

# 小程序配置
WX_APPID=
WX_SECRET=
# 小程序 JWT 签名密钥
M_JWT_SECRET=

# 微信商户配置（PAY_MODE=real 时必填）
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PUB_KEY_ID=
WECHAT_CERT_PATH=/app/certs
WECHAT_NOTIFY_URL=

# 定时查单兜底配置
ENABLE_ORDER_CHECK=true
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_CHECK_INTERVAL_SECONDS=300

# dashboard
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
TRUSTED_ORIGINS=
PAYMENT_API_BASE_URL=
OSS_API_BASE_URL=
NEXT_PUBLIC_APP_URL=
