# Git 仓库配置
GIT_REPO_URL=https://github.com/apEeach/DS_Course.git
# SSH 私钥在宿主机上的绝对路径（第三方私有仓库才需要）
GIT_SSH_KEY_PATH=

# 是否启动 mysql 容器（true/false），false 时需自行提供外部数据库
ENABLE_MYSQL=true

# 是否执行数据库初始化脚本 init_db.sh（true/false），仅在使用数据库时生效
ENABLE_INIT_DB=true

# 数据库配置
DB_HOST=db
DB_USER=root
DB_PASS=root
DB_NAME=mydb
